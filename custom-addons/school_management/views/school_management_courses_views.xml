<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View school_management.courses View Tree -->
    <record id="view_school_management_courses_tree" model="ir.ui.view">
        <field name="name">view.school_management.courses.tree</field>
        <field name="model">school_management.courses</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="duration"/>
            </tree>
        </field>
    </record>

    <!-- View school_management.courses form -->
    <record id="view_school_management_courses_form" model="ir.ui.view">
        <field name="name">view.school_management.courses.form</field>
        <field name="model">school_management.courses</field>
        <field name="arch" type="xml">
            <form string="School_management Courses">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group name="Basic Information" string="Basic Information">
                            <field name="description" placeholder="Description..."/>
                            <field name="duration" placeholder="Duration..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View school_management.courses search -->
    <record id="view_school_management_courses_search" model="ir.ui.view">
        <field name="name">view.school_management.courses.search</field>
        <field name="model">school_management.courses</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action school_management.courses -->
    <record id="action_school_management_courses" model="ir.actions.act_window">
        <field name="name">School_management Courses</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">school_management.courses</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new School_management Courses.
            </p>
        </field>
    </record>

    <menuitem
        id="courses_menu"
        name="Courses"
        parent="school_management_system_root_menu"
        action="action_school_management_courses"/>
</odoo>
